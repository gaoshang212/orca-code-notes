<UserControl x:Class="OrcaNotes.SavedNoteCard" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" FontSize="13" Margin="0,4">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#40888888"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#50888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#70888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Opacity" Value=".82"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Background" Value="#50888888"/>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Frame" CornerRadius="7" BorderThickness="1" Padding="14,10">
        <StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="Actions" Grid.Column="1" HorizontalAlignment="Right" BorderBrush="{Binding BorderBrush, ElementName=Frame}"
                        BorderThickness="1" CornerRadius="6" Padding="1,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Send" Style="{StaticResource IconButton}" AutomationProperties.AutomationId="OrcaNoteSend">
                            <Path Style="{StaticResource Icon}" Data="M2,8 L18,2 12,18 8,11 Z M8,11 L18,2"/>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <Button x:Name="Edit" Style="{StaticResource IconButton}" AutomationProperties.AutomationId="OrcaNoteEdit">
                            <Path Style="{StaticResource Icon}" Data="M3,17 L4,12 14,2 Q15,1 16,2 L18,4 Q19,5 18,6 L8,16 Z M12,4 L16,8"/>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <Button x:Name="Delete" Style="{StaticResource IconButton}" AutomationProperties.AutomationId="OrcaNoteDelete">
                            <Path Style="{StaticResource Icon}" Data="M2,5 L18,5 M7,5 L7,3 Q7,2 8,2 L12,2 Q13,2 13,3 L13,5 M4,5 L5,17 Q5,18 6,18 L14,18 Q15,18 15,17 L16,5"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer Margin="0,7,0,2" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <TextBlock x:Name="Body" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
